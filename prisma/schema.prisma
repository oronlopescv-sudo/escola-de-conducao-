generator client {
  provider = "prisma-client-js"
  // Alpine (musl) com OpenSSL 3 — necessário para o runtime do Docker
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  ALUNO
}

enum Categoria {
  A
  B
  C
  D
  F
  A1
  B1
  C1
  D1
  BE
  CE
  DE
}

model Escola {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  email     String
  telefone  String?
  morada    String?
  // Espaço liberado (pagamento confirmado ou decisão do super-admin)
  ativo     Boolean  @default(false)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  pagamentoAte          DateTime?
  criadoEm  DateTime @default(now())

  admins       User[]
  alunos       Aluno[]
  agendamentos Agendamento[]
  tentativas   Tentativa[]

  @@index([ativo])
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      Role     @default(ALUNO)
  // null => SUPERADMIN (gestor da plataforma)
  escolaId  String?
  escola    Escola?  @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())
  aluno     Aluno?

  @@index([escolaId])
}

model Aluno {
  id             String            @id @default(cuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  escolaId       String?
  escola         Escola?           @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  telefone       String?
  dataNascimento DateTime?
  morada         String?
  documento      String?
  categoria      Categoria         @default(B)
  dataInscricao  DateTime          @default(now())
  ativo          Boolean           @default(true)
  progresso      ModuloProgresso[]
  tentativas     Tentativa[]
  agendamentos   Agendamento[]

  @@index([escolaId])
}

model Agendamento {
  id            String   @id @default(cuid())
  escolaId      String?
  escola        Escola?  @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  alunoId       String
  aluno         Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  tipo          String   @default("Théorique") // "Théorique" | "Pratique"
  data          DateTime
  hora          String
  duracao       Int      @default(60)
  local         String?
  instrutorNome String?
  status        String   @default("Confirmé") // "Confirmé" | "Annulé" | "Terminé"
  criadoEm      DateTime @default(now())

  @@index([escolaId, data])
}

model Modulo {
  id        String            @id @default(cuid())
  numero    Int               @unique
  titulo    String
  descricao String?
  videoUrl  String?
  questoes  Questao[]
  progresso ModuloProgresso[]
}

model ModuloProgresso {
  alunoId     String
  moduloId    String
  concluido   Boolean   @default(false)
  concluidoEm DateTime?
  aluno       Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  modulo      Modulo    @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@id([alunoId, moduloId])
}

model Questao {
  id         String  @id @default(cuid())
  moduloId   String?
  modulo     Modulo? @relation(fields: [moduloId], references: [id], onDelete: SetNull)
  enunciado  String
  opcaoA     String
  opcaoB     String
  opcaoC     String?
  opcaoD     String?
  correta    String // "A" | "B" | "C" | "D"
  explicacao String?
}

model Tentativa {
  id       String   @id @default(cuid())
  alunoId  String
  aluno    Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  escolaId String?
  escola   Escola?  @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  criadaEm DateTime @default(now())
  total    Int
  acertos  Int
  detalhes Json // [{questaoId, resposta, correta}]

  @@index([escolaId, criadaEm])
}
